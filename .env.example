# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.
# See docs/PROVIDERS.md for the full provider matrix.

# --- Required ---
# Anthropic API key: default LLM provider AND powers web search on every provider.
ANTHROPIC_API_KEY=sk-ant-...

# --- LLM provider (optional; default = anthropic direct) ---
# One of: anthropic | bedrock | gateway | openai
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5

# --- Amazon Bedrock (only if LLM_PROVIDER=bedrock) ---
# Credentials resolve via the AWS chain (profile / SSO / instance role).
# LLM_PROVIDER=bedrock
# LLM_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # cross-region inference profile id
# AWS_PROFILE=your-aws-profile
# AWS_REGION=us-east-1

# --- Optional: web search fallback when NOT using Anthropic (Tavily or Exa) ---
# TAVILY_API_KEY=
# EXA_API_KEY=
# SEARCH_PROVIDER=tavily   # or exa

# --- Optional: cost / behavior tuning ---
# LLM_RESEARCH_MODEL=claude-sonnet-4-5   # cheaper: claude-haiku-4-5
# RESEARCH_STEPS=5                        # tool-call rounds in the research pass
# NO_RESEARCH_CACHE=1                     # disable the per-domain research cache
# LOG_LEVEL=info
